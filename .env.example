# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Project Settings › API). .env.local no se sube al repositorio.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
VITE_STORAGE_BUCKET_DOCS=greenspot-docs
VITE_STORAGE_BUCKET_MEDIA=greenspot-media

# Solo para «npm run pruebas»: una cuenta de operario de prueba
GREENSPOT_CORREO=
GREENSPOT_CLAVE=
