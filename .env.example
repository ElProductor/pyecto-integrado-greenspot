# ==============================================================================
# GREENSPOT INVENTORY & CIRCULAR ECONOMY - CONFIGURACIÓN SUPABASE
# ==============================================================================

# URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon Key pública de tu proyecto Supabase (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase-aqui

# Nombre de los buckets de Supabase Storage
VITE_STORAGE_BUCKET_DOCS=greenspot-docs
VITE_STORAGE_BUCKET_MEDIA=greenspot-media
